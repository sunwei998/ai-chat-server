# SiliconFlow API 网关地址（API 密钥改在「管理后台-通用维表-模型提供商」中按供应商维护）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# JWT
JWT_SECRET=please-change-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# 首次启动 seed 时创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SQLite 数据库文件路径（相对项目根目录）
DB_PATH=data/chat.db

# CORS 白名单（逗号分隔；本地前端地址）
CORS_ORIGINS=http://localhost:5173,http://localhost:5199